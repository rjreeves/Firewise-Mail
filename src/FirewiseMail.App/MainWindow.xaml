<Window x:Class="FirewiseMail.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FW Mail"
        Width="1280"
        Height="840"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#20312B" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#20312B" />
        </Style>
    </Window.Resources>

    <Grid Background="#F6F7F4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#20312B" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Fire-Wise Mail"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Prepare, review, and send the Fire Wise email run."
                               Foreground="#D7E5DE"
                               Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock x:Name="HeaderStatusText"
                           Grid.Column="1"
                           Foreground="#D7E5DE"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Not ready" />
            </Grid>
        </Border>

        <Grid x:Name="WorkflowGrid" Grid.Row="1" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RightColumn" Width="340" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="WorkRow" Height="620" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <GroupBox Header="Database">
                    <StackPanel>
                        <Button x:Name="TestConnectionButton"
                                Content="Test Connection"
                                Margin="0,0,0,8"
                                Click="TestConnectionButton_Click" />
                        <Button x:Name="PrepareEmailTableButton"
                                Content="Prepare / Reset"
                                Margin="0,0,0,8"
                                Click="PrepareEmailTableButton_Click" />
                        <Button x:Name="LoadRecipientsButton"
                                Content="Load Recipients"
                                Click="LoadRecipientsButton_Click" />

                        <TextBlock x:Name="DatabaseStatusText"
                                   Margin="0,12,0,0"
                                   Text="Database actions have not been run."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Recipients">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Total" Style="{StaticResource LabelText}" />
                            <TextBlock x:Name="TotalRecipientsText" Text="0" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Pending" Style="{StaticResource LabelText}" />
                            <TextBlock x:Name="PendingRecipientsText" Text="0" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mailed" Style="{StaticResource LabelText}" />
                            <TextBlock x:Name="MailedRecipientsText" Text="0" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Configuration">
                    <StackPanel>
                        <TextBlock Text="Database" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="DatabaseText"
                                   Margin="0,3,0,10"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="SMTP" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="SmtpText"
                                   Margin="0,3,0,10"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Batch Size" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="BatchSizeText"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </GroupBox>
                </StackPanel>

                <GroupBox Grid.Column="1" Header="Email" Margin="0,0,16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Subject" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="SubjectTextBox"
                                 Margin="0,4,0,12"
                                 TextChanged="CompositionChanged" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="HTML Body" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="BodyTextBox"
                                 Grid.Row="1"
                                 Margin="0,4,0,0"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextChanged="CompositionChanged" />
                    </Grid>

                    <TextBlock x:Name="AddressesText"
                               Grid.Row="2"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                </Grid>
                </GroupBox>

                <StackPanel Grid.Column="2">
                <GroupBox Header="Attachments">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="150" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SelectAttachmentsButton"
                                    Content="Select PDFs"
                                    Width="130"
                                    Margin="0,0,8,0"
                                    Click="SelectAttachmentsButton_Click" />
                            <Button x:Name="ClearAttachmentsButton"
                                    Content="Clear"
                                    Width="82"
                                    Click="ClearAttachmentsButton_Click" />
                        </StackPanel>

                        <ListBox x:Name="AttachmentsListBox"
                                 Grid.Row="1"
                                 Margin="0,12,0,12" />

                        <TextBlock x:Name="AttachmentCountText"
                                   Grid.Row="2"
                                   Text="0 of 3 PDFs selected" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Campaign Readiness">
                    <StackPanel>
                        <TextBlock x:Name="ValidationText"
                                   Text="Select recipients, subject/body, and at least one PDF."
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold" />
                        <CheckBox x:Name="DryRunCheckBox"
                                  Content="Dry run only"
                                  Margin="0,12,0,0"
                                  Checked="CompositionChanged"
                                  Unchecked="CompositionChanged" />
                        <ProgressBar x:Name="SendProgressBar"
                                     Margin="0,14,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="18" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SendProgressText"
                                       Text="Not sending."
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SendPercentText"
                                       Grid.Column="1"
                                       Margin="12,0,0,0"
                                       Text="0%" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="SendCampaignButton"
                                    Content="Send"
                                    Width="138"
                                    Margin="0,0,8,0"
                                    Click="SendCampaignButton_Click" />
                            <Button x:Name="StopSendButton"
                                    Content="Stop"
                                    Width="80"
                                    IsEnabled="False"
                                    Click="StopSendButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Latest Error">
                    <TextBlock x:Name="LatestErrorText"
                               Text="No errors."
                               TextWrapping="Wrap" />
                </GroupBox>
                </StackPanel>

                <GroupBox Grid.Row="1" Grid.ColumnSpan="3" Header="Logs" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Success log" Style="{StaticResource LabelText}" Margin="0,0,12,4" />
                    <TextBlock x:Name="SuccessLogText" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="1" Text="Error log" Style="{StaticResource LabelText}" Margin="0,0,12,4" />
                    <TextBlock x:Name="ErrorLogText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="2" Text="SMTP log" Style="{StaticResource LabelText}" Margin="0,0,12,0" />
                    <TextBlock x:Name="SmtpProtocolLogText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
                </GroupBox>
        </Grid>

        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Background="#E8ECE8"
                   Padding="24,10"
                   Text="Ready"
                   Foreground="#20312B" />
    </Grid>
</Window>
